CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
database.default.hostname = localhost
database.default.database = pagus
database.default.username = pagus
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
PAGUS_ADMIN_EMAIL = admin@example.com
PAGUS_ADMIN_PASSWORD = change-this-password
# 카카오 로컬 API 키 — https://developers.kakao.com 앱의 REST API 키
# 장소(참고 데이터) 검색과 주소 검색(맛집 등록 시 도로명/지번 주소 조회)에 함께 쓰인다.
kakaolocal.apiKey =
# 카카오맵 JS SDK 키 — 위 REST API 키와 다른 JavaScript 키. 브라우저에 노출되므로
# 카카오 개발자 콘솔 앱 설정 > 플랫폼 > Web 에 서비스 도메인을 등록해야 한다.
kakaomaps.jsKey =
# Groq API 키 — https://console.groq.com 에서 발급. 관리자 맛집 등록/수정 화면의 AI 카테고리 추천에 쓰인다.
# 비워두거나 호출이 실패하면 카테고리를 직접 선택할 수 있다.
groq.apiKey =
# 선택: 생략하면 기본값(llama-3.1-8b-instant) 사용
# groq.model = llama-3.1-8b-instant
# Google Search Console 소유 확인 코드(HTML 태그 방식의 content 값만). 비워두면 메타 태그를 생략한다.
seo.googleVerify =
# Bing Webmaster Tools 소유 확인 코드(content 값만). 비워두면 메타 태그를 생략한다.
seo.bingVerify =
# GPTBot·PerplexityBot 등 AI 검색/학습 크롤러를 robots.txt에서 허용할지 여부.
seo.aiCrawlersAllow = true
